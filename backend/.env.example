# ===== SentinelIQ Environment Configuration =====
# Copy this file to .env and fill in your actual values.
#
# PRODUCTION: All REQUIRED variables must be set. The app will refuse to start
# if any required variable is missing. Do NOT set LOCAL_DEVELOPMENT=true in prod.
#
# DEVELOPMENT: Set LOCAL_DEVELOPMENT=true to use localhost defaults for
# DATABASE_URL, REDIS_URL, NEO4J_URI, and CORS_ORIGINS.

# ----- Development Mode -----
# Set to true for local development (enables localhost defaults)
LOCAL_DEVELOPMENT=true

# ----- PostgreSQL + pgvector (REQUIRED in production) -----
# Supabase provides this: Project Settings > Database > Connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentineliq

# ----- Supabase Auth (REQUIRED in production) -----
# Create a project at https://supabase.com and get these from Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ----- Groq Inference (REQUIRED — no fallback) -----
# Get your key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ----- Voyage AI Embeddings (REQUIRED — no fallback) -----
# Get your key at https://docs.voyageai.com
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_MODEL=voyage-3
EMBEDDING_DIM=1024

# ----- Cohere Reranker (optional second stage after RRF) -----
# Leave blank to skip reranking; RRF scores alone will be used
COHERE_API_KEY=
RERANKER_MODEL=rerank-v3-enterprise

# ----- CORS (REQUIRED in production) -----
# Comma-separated origins. Use * for dev (credentials disabled when *)
CORS_ORIGINS=http://localhost:3000

# ----- Neo4j Knowledge Graph (REQUIRED in production) -----
# Required for asset/alert correlation paths and blast radius analysis
# For Neo4j Aura: bolt://your-db.databases.neo4j.io:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ----- Redis Checkpointer (REQUIRED in production) -----
# Required for LangGraph state persistence + conversation memory
# For Upstash: redis://default:your-password@your-endpoint.upstash.io:6379/0
REDIS_URL=redis://localhost:6379/0

# ----- RAG Pipeline -----
CHUNK_SIZE=2000
CHUNK_OVERLAP=300
RAG_TOP_K=20
RAG_RERANK_TOP_N=5

# ----- Retrieval Confidence / Abstention -----
# Minimum RRF score for the top result. Set >0 to enable abstention.
# If the top retrieval score is below this threshold, the system returns
# an evidence-insufficient response instead of generating an unsupported answer.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.0

# ----- Conversation Memory -----
# Maximum conversation turns stored per conversation
CONVERSATION_MAX_TURNS=20

# ----- Langfuse Observability (optional) -----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
